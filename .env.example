# MongoDB: local server or Atlas (mongodb+srv://user:pass@cluster/...)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=perfect_enginering

# JWT
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Frontend origin(s), comma separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://perfect-enginering.netlify.app
TIMEZONE=Asia/Kolkata
SHIFT_START=08:00
SHIFT_END=17:00

# DEMO_MODE=true returns OTP / reset link in API responses (no SMS/email gateway). Set false in production.
DEMO_MODE=true
DEFAULT_ADMIN_EMAIL=aravinth@perfectenginering.com
DEFAULT_ADMIN_PASSWORD=aravinth@5432